{
  "name": "porcupine",
  "version": "0.0.0",
  "private": true,
  "description": "Research & thesis management platform",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm --filter @porcupine/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "pnpm --filter @porcupine/db diff",
    "db:generate": "pnpm --filter @porcupine/db generate",
    "db:test": "pnpm --filter @porcupine/db test",
    "guards": "bash scripts/guards.sh",
    "check-tests": "bash scripts/check-tests.sh",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.114.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
