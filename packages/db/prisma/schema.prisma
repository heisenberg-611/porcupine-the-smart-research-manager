// Porcupine — schema (Phase 0 slice)
//
// Source of truth for DDL. RLS policies live in hand-written SQL under
// supabase/migrations/ and are the actual security boundary — Prisma cannot
// express them.
//
// NEVER run `prisma migrate dev` against a Supabase database — it does not
// know about policies, roles, or extensions and will drop them. Use
// `pnpm db:diff` (prisma migrate diff) to emit SQL, then hand-edit.
//
// Conventions:
//   * Tables and columns are snake_case in Postgres via @map/@@map. The RLS
//     and pgTAP SQL is hand-written and read often; quoted camelCase there
//     is a permanent tax.
//   * All timestamps are `timestamptz`. Store UTC, render in the viewer's
//     zone, never do date math in local time (hazard B-07).
//
// See docs/01-data-model.md and docs/05-resolution-plan.md R-02.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

// Prisma 7: connection URLs live in prisma.config.ts, and the runtime client
// takes a driver adapter. See src/index.ts.
datasource db {
  provider = "postgresql"
}

// ═══════════════════════════ Enums ═══════════════════════════

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectKind {
  THESIS
  SYSTEMATIC_REVIEW
  LAB_PAPER
  GENERAL
}

/// R-09: separates "my supervisor" from "who runs this project".
/// STUDENT_OWNED defaults the student to owner, supervisor to reviewer.
/// LAB_OWNED defaults the PI to owner. Visible and changeable, never implicit.
enum OwnershipModel {
  STUDENT_OWNED
  LAB_OWNED
}

enum Visibility {
  PRIVATE
  ORG
}

enum AccessRole {
  OWNER
  ADMIN
  CONTRIBUTOR
  REVIEWER
  OBSERVER
}

/// CRediT-adjacent working roles. R-07/ADR-022: these describe *what someone
/// does*, never how much they did. No scores, percentages, or rankings.
enum FunctionRole {
  CONCEPTUALIZATION
  METHODOLOGY
  INVESTIGATION
  DATA_CURATION
  FORMAL_ANALYSIS
  WRITING_ORIGINAL
  WRITING_REVIEW
  VISUALIZATION
  SUPERVISION
  PROJECT_ADMIN
}

/// ADR-006: prompted when a member is added after project creation.
enum HistoryAccess {
  ALL_HISTORY
  FROM_JOIN
}

enum DigestCadence {
  NONE
  DAILY
  WEEKLY
}

// ─────────────────────── Phase 1: corpus & reading ───────────────────────

/// The screening pipeline. PRISMA 2020 reporting is derived from transitions
/// through these states, so the set is fixed by the standard, not by taste.
enum ScreenStatus {
  IDENTIFIED
  SCREENING
  INCLUDED
  EXCLUDED
  READING
  EXTRACTED
  SYNTHESIZED
}

enum ReadStatus {
  NOT_STARTED
  SKIMMED
  READ
  REREAD
}

/// R-04: where a file's bytes are allowed to live.
/// SHARED is only ever reached by an Unpaywall-verified open-access file —
/// publisher PDFs are never deduplicated between users (ADR-005, copyright).
/// Renamed from R2_SHARED/R2_USER while the table still had zero rows: the
/// backend is Supabase Storage, not R2 (docs/12-file-storage-build-plan.md §2),
/// and an enum that names the wrong vendor only gets more expensive to fix.
enum Residency {
  SHARED
  PRIVATE
  DEVICE_ONLY
}

/// An upload can succeed without the app hearing about it, so upload state is
/// tracked explicitly and reconciled against the bucket by a nightly job.
enum UploadState {
  PENDING
  COMPLETE
  ORPHANED
}

enum TextStatus {
  PENDING
  EXTRACTED
  FAILED
  NOT_APPLICABLE
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

/// DRIFTED is first-class: an anchor that silently moved is far worse than one
/// that breaks loudly, because the quote still renders and looks correct.
enum AnchorStatus {
  OK
  DRIFTED
  BROKEN
}

enum AnnotationKind {
  HIGHLIGHT
  NOTE
  QUESTION
  TODO
}

enum AnnotationVisibility {
  PRIVATE
  PROJECT
}

// ─────────────────────── Phase 2: extraction ───────────────────────

/// The field types a protocol can declare.
///
/// QUOTE and CITATION are not decoration: a QUOTE field captures an Anchor
/// when the extractor highlights, which is what makes "cell → the exact
/// passage it came from" possible in the evidence table.
enum FieldType {
  TEXT
  LONG_TEXT
  NUMBER
  BOOLEAN
  ENUM
  MULTI_ENUM
  DATE
  QUOTE
  CITATION
  URL
}

/// DRAFT until submitted, so a half-filled form is never mistaken for a
/// finding. IN_CONFLICT and RECONCILED are reached only by dual extraction
/// (Phase 2b) — declared now so that path needs no migration.
enum ExtractionStatus {
  DRAFT
  SUBMITTED
  IN_CONFLICT
  RECONCILED
  VERIFIED
}

/// Inert. ADR-003: no AI in v1. Reserved so an assisted extraction can be
/// distinguished from a human one later without a migration, and so nothing
/// has to guess retrospectively which was which.
enum ExtractionOrigin {
  HUMAN
  ASSISTED
}

// ═══════════════════════ Identity & tenancy ═══════════════════════

model User {
  id          String   @id @db.Uuid // = auth.users.id
  email       String   @unique
  displayName String   @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  orcid       String?  @unique
  affiliation String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // E2EE identity — public halves only. Generated at signup from Phase 0,
  // even though nothing is encrypted until Phase 3. Existing keys are why
  // Phase 3 needs no painful re-enrollment.
  identityPubKey Bytes? @map("identity_pub_key") // X25519, sealed-box key wrapping
  signingPubKey  Bytes? @map("signing_pub_key") // Ed25519, signing key wraps
  wrappedBundle  Bytes? @map("wrapped_bundle") // private keys under the Master Key
  kdfSalt        Bytes? @map("kdf_salt") // Argon2id salt, distinct from auth's
  keyBundleVer   Int    @default(0) @map("key_bundle_ver")

  /// Requested deletion, not yet carried out.
  ///
  /// The account is unusable from the moment this is set — middleware turns
  /// every request away — but the row is untouched, so signing in during the
  /// window can still cancel it. That window is the whole point: deleting an
  /// account is the one action in this product with no undo, and the people
  /// most likely to take it are the ones having a bad day.
  deletionScheduledAt DateTime? @map("deletion_scheduled_at") @db.Timestamptz(3)

  /// The scrub has run. Email, name, avatar, ORCID, affiliation and every key
  /// column are gone; the row itself is not.
  ///
  /// It cannot be, and saying why is more useful than a comment about foreign
  /// keys: `screening_decisions.decided_by` points here, and "who excluded
  /// these forty papers, and when" has to keep having an answer a year later.
  /// That is the entire argument for the PRISMA diagram being defensible. So
  /// this is pseudonymisation rather than erasure, and the DPA page says so in
  /// those words rather than claiming the stronger thing.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  memberships ProjectMember[]
  devices     Device[]
  decisions   ScreeningDecision[]
  imports     ImportBatch[]
  orgMembers  OrgMember[]
  projectKeys ProjectKey[]
  channels    Channel[]
  messages    Message[]

  /// The ten relations below existed as bare uuid columns with NO foreign key
  /// at all until account deletion was built.
  ///
  /// That is worse than it sounds. A `delete from users` did not fail on
  /// them — it succeeded, and left `annotations.author_id`,
  /// `extractions.extractor_id`, `projects.created_by` and seven more pointing
  /// at a row that no longer existed. Nothing would have reported it; the
  /// screens that join through them would simply have started returning
  /// nothing, which reads as "no annotations yet".
  ///
  /// They are RESTRICT (Prisma's default for a required relation), which is
  /// the correct answer for every one of them: none of this content should
  /// vanish because its author closed their account, and the deletion path
  /// anonymises the row rather than removing it. The constraint is what stops
  /// the next person reaching for `DELETE`.
  invitedMembers   ProjectMember[]      @relation("MemberInvitedBy")
  createdProjects  Project[]            @relation("ProjectCreatedBy")
  addedWorks       ProjectWork[]        @relation("WorkAddedBy")
  assignedWorks    ProjectWork[]        @relation("WorkAssignee")
  annotations      Annotation[]         @relation("AnnotationAuthor")
  extractions      Extraction[]         @relation("ExtractionExtractor")
  verifications    Extraction[]         @relation("ExtractionVerifiedBy")
  wrappedKeys      ProjectKey[]         @relation("KeyWrappedBy")
  ownedFiles       FileObject[]         @relation("FileOwner")
  savedSearches    SavedSearch[]        @relation("SearchCreatedBy")
  prismaCountEdits PrismaManualCounts[] @relation("PrismaCountsEditor")

  @@map("users")
}

model Device {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  label            String // "MacBook Pro", "Pixel 8"
  devicePubKey     Bytes     @map("device_pub_key")
  wrappedMasterKey Bytes     @map("wrapped_master_key") // sealed to this device
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

model Organization {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  slug          String   @unique
  ssoProvider   String?  @map("sso_provider") // saml | oidc | null
  domain        String? // auto-join by email domain
  retentionDays Int?     @map("retention_days")
  escrowEnabled Boolean  @default(false) @map("escrow_enabled") // ADR-009, opt-in
  escrowPubKey  Bytes?   @map("escrow_pub_key")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  members  OrgMember[]
  projects Project[]

  @@map("organizations")
}

model OrgMember {
  orgId    String   @map("org_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     OrgRole  @default(MEMBER)
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(3)

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
  @@index([userId])
  @@map("org_members")
}

// ═══════════════════════ Projects & membership ═══════════════════════

model Project {
  id    String  @id @default(uuid()) @db.Uuid
  orgId String? @map("org_id") @db.Uuid
  slug  String

  title       String
  description String?

  /// R-06: this branches the UI via capabilities(kind), it does not merely
  /// label the project. THESIS is the default and ships first.
  kind           ProjectKind    @default(THESIS)
  ownershipModel OwnershipModel @default(STUDENT_OWNED) @map("ownership_model")
  visibility     Visibility     @default(PRIVATE)

  /// Inert. Reserved so AI is addable later without a migration (ADR-003).
  /// Do not build against this.
  assistEnabled Boolean @default(false) @map("assist_enabled")

  /// Where members go for a paper the DOI will not open — a library link
  /// resolver, a proxy, an ILL form. No default: a wrong resolver fails
  /// silently and looks like the paper is unavailable.
  accessHelpUrl   String? @map("access_help_url")
  accessHelpLabel String? @map("access_help_label")

  /// The ID of the dedicated Google Drive folder for this project.
  driveFolderId String? @map("drive_folder_id")

  /// The refresh token of the Admin who provisioned the Google Drive folder.
  /// Used to grant access to collaborators asynchronously.
  googleRefreshToken String? @map("google_refresh_token")

  /// How many papers each member is expected to extract, or null for no
  /// target. One number for the whole project rather than a per-member quota:
  /// the case this exists for is "100 papers, four of us, 25 each", and a
  /// per-member table would be four rows of the same number plus a screen to
  /// maintain them.
  ///
  /// It is a TARGET, not a limit. Nothing refuses an extraction past it — the
  /// dashboard just stops saying you are behind. A quota the software enforced
  /// would be a quota that blocks the person who volunteered to take the last
  /// twelve papers.
  extractionTarget Int? @map("extraction_target")

  currentKeyEpoch Int       @default(0) @map("current_key_epoch")
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy       String    @map("created_by") @db.Uuid

  org      Organization?   @relation(fields: [orgId], references: [id])
  creator  User            @relation("ProjectCreatedBy", fields: [createdBy], references: [id])
  members  ProjectMember[]
  keys     ProjectKey[]
  channels Channel[]
  messages Message[]

  activity           ProjectActivity[]
  prismaCounts       PrismaManualCounts?
  questions          Question[]
  savedSearches      SavedSearch[]
  projectWorks       ProjectWork[]
  files              FileObject[]
  anchors            Anchor[]
  screeningDecisions ScreeningDecision[]
  importBatches      ImportBatch[]
  protocols          Protocol[]
  extractions        Extraction[]

  @@unique([orgId, slug])
  @@index([createdBy])
  @@map("projects")
}

/// A content-free "something changed here" marker, one row per project per
/// kind, bumped by database triggers.
///
/// Nothing in the application reads this through Prisma, and nothing should:
/// it exists to reach the write-ahead log so Supabase Realtime can tell a
/// browser to refetch. It is modelled here only because `pnpm db:diff`
/// compares the live database against this file, and a table missing from it
/// reads as drift to be dropped.
///
/// See supabase/migrations/20260818160000_project_activity_signal.sql for why
/// it holds no content and why it is the only table in the realtime
/// publication.
model ProjectActivity {
  projectId String   @map("project_id") @db.Uuid
  kind      String
  at        DateTime @default(now()) @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, kind])
  @@map("project_activity")
}

/// The PRISMA 2020 numbers this application cannot count for itself.
///
/// The flow diagram has boxes for things no amount of instrumentation here
/// would know: how many records an automation tool marked ineligible, how many
/// reports were sought from a library and never arrived, how many studies were
/// found by chasing citations rather than by searching. Those happen outside
/// the app, in a librarian's inbox and a reference list.
///
/// They are still required. A diagram with those boxes blank is not
/// submittable, and a diagram with them silently zeroed asserts that no report
/// failed retrieval — a claim nobody checked. So they are entered by a person,
/// stored here, and rendered in the same figure as the counted ones, with the
/// page saying plainly which is which.
///
/// Nullable throughout, and that is the whole design. Null means "we have not
/// said", and renders as a dash; zero means "we checked, and it was none".
/// Collapsing those two is exactly the error this table exists to avoid.
model PrismaManualCounts {
  projectId String @id @map("project_id") @db.Uuid

  /// Identification — the split the app cannot make. `records_identified` in
  /// v_prisma_flow counts everything that arrived; PRISMA wants databases and
  /// trial registers separately, and registers are searched by hand.
  registersIdentified Int? @map("registers_identified")

  /// Removed before screening, beyond the duplicates the importer merged.
  automationIneligible Int? @map("automation_ineligible")
  otherRemovedBefore   Int? @map("other_removed_before")

  /// Full-text retrieval. Nothing in this app touches a PDF, so both of these
  /// are somebody reporting what their library did.
  reportsSought       Int? @map("reports_sought")
  reportsNotRetrieved Int? @map("reports_not_retrieved")

  /// The right-hand column of the 2020 diagram: everything found by a route
  /// other than the database search.
  otherWebsites            Int? @map("other_websites")
  otherOrganisations       Int? @map("other_organisations")
  otherCitationSearching   Int? @map("other_citation_searching")
  otherReportsSought       Int? @map("other_reports_sought")
  otherReportsNotRetrieved Int? @map("other_reports_not_retrieved")
  otherReportsAssessed     Int? @map("other_reports_assessed")
  otherReportsExcluded     Int? @map("other_reports_excluded")
  otherStudiesIncluded     Int? @map("other_studies_included")

  /// Studies versus reports. One study can be published several times, and
  /// PRISMA counts both — the app has no way to know two records describe one
  /// study unless somebody says so.
  reportsOfIncludedStudies Int? @map("reports_of_included_studies")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String   @map("updated_by") @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  editor  User    @relation("PrismaCountsEditor", fields: [updatedBy], references: [id])

  @@map("prisma_manual_counts")
}

model ProjectMember {
  id            String         @id @default(uuid()) @db.Uuid
  projectId     String         @map("project_id") @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  accessRole    AccessRole     @default(CONTRIBUTOR) @map("access_role")
  functionRoles FunctionRole[] @map("function_roles")
  invitedBy     String?        @map("invited_by") @db.Uuid
  joinedAt      DateTime?      @map("joined_at") @db.Timestamptz(3)
  removedAt     DateTime?      @map("removed_at") @db.Timestamptz(3)

  /// ADR-006. Set by the prompt shown when adding a member after project
  /// creation. Gates plaintext history and prior-epoch key re-wraps.
  historyAccess HistoryAccess @default(ALL_HISTORY) @map("history_access")
  historyFrom   DateTime?     @map("history_from") @db.Timestamptz(3)

  digestCadence DigestCadence @default(DAILY) @map("digest_cadence")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviter User?   @relation("MemberInvitedBy", fields: [invitedBy], references: [id])

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

/// The project symmetric key sealed to one member's identity key.
/// One row per (project, member, epoch). Rotation = new epoch + N new rows.
/// Old epochs are NEVER deleted — old ciphertext stays readable forever.
model ProjectKey {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  epoch      Int
  wrappedKey Bytes    @map("wrapped_key") // crypto_box_seal(key, identityPubKey)
  wrappedBy  String   @map("wrapped_by") @db.Uuid
  signature  Bytes // Ed25519 over (projectId|userId|epoch|wrappedKey)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  wrapper User    @relation("KeyWrappedBy", fields: [wrappedBy], references: [id])

  @@unique([projectId, userId, epoch])
  @@index([userId])
  @@map("project_keys")
}

// ═══════════════════════ Messaging (Phase 3) ═══════════════════════

/// A conversation inside a project.
///
/// The NAME is ciphertext. A server that could read channel names would know
/// the shape of the work even without the messages, and "we cannot read your
/// messages but we can read what you called the conversation" is the kind of
/// half-claim this schema keeps out.
model Channel {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  nameCt    Bytes    @map("name_ct")
  epoch     Int
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author   User      @relation(fields: [createdBy], references: [id])
  messages Message[]

  @@index([projectId])
  @@map("channels")
}

/// One message. Append-only: there is no UPDATE or DELETE policy on this
/// table, because an edited ciphertext is indistinguishable from a substituted
/// one.
model Message {
  id         String   @id @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  channelId  String   @map("channel_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  /// Which project key opens this. Rotation does not re-encrypt history — it
  /// cannot, the server holds no key — so every row names its own epoch.
  epoch      Int
  ciphertext Bytes
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([channelId, createdAt])
  @@map("messages")
}

// ═══════════════════════ Infrastructure ═══════════════════════

/// R-22: token buckets shared across every Lambda invocation.
///
/// Declared here only so `db:diff` sees no drift. Nothing reads or writes it
/// through Prisma — the table is deny-all and the sole write path is the
/// SECURITY DEFINER `rate_limit_take()`. See the migration for why the bucket
/// has to live in Postgres at all.
model RateLimitBucket {
  key             String   @id
  tokens          Float
  capacity        Float
  refillPerSecond Float    @map("refill_per_second")
  /// Full precision, unlike every other timestamp here: at millisecond
  /// precision the rounding can make elapsed time negative. See the migration.
  ///
  /// `clock_timestamp()`, not Prisma's `now()` — which maps to
  /// CURRENT_TIMESTAMP, i.e. transaction start time, frozen for the whole
  /// transaction. That is exactly the clock a token bucket must not use, and
  /// leaving them mismatched also made `db:diff` want to rewrite the default.
  updatedAt       DateTime @default(dbgenerated("clock_timestamp()")) @map("updated_at") @db.Timestamptz(6)

  @@map("rate_limit_buckets")
}

/// One row per completed import.
///
/// Exists because PRISMA 2020 requires the count of records removed before
/// screening, and the import path used to deduplicate silently — the number
/// could not be reconstructed afterwards. Append-only: these figures end up
/// in a published methods section.
model ImportBatch {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  importedBy     String   @map("imported_by") @db.Uuid
  format         String
  submitted      Int
  deduplicated   Int      @default(0)
  alreadyPresent Int      @default(0) @map("already_present")
  added          Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  importer User    @relation(fields: [importedBy], references: [id])

  @@index([projectId, createdAt(sort: Desc)], map: "import_batches_project_idx")
  @@map("import_batches")
}

// ═══════════════════════ Research questions ═══════════════════════

/// The questions a project exists to answer. Plaintext by design: these drive
/// keyword ranking at search time and the coverage view that shows which
/// questions no included paper actually addresses.
model Question {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  order     Int
  text      String
  keywords  String[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project        Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent         Question?             @relation("QuestionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children       Question[]            @relation("QuestionTree")
  works          ProjectWorkQuestion[]
  protocolFields ProtocolField[]

  @@index([projectId])
  @@map("questions")
}

// ═══════════════════════ Bibliography (global) ═══════════════════════

/// Global and deduplicated — NOT project-scoped. One row per paper in the
/// world, readable by any authenticated user, writable only through the
/// server (see the RLS migration: there is no INSERT policy for end users).
///
/// This is the one table in the system that is deliberately not tenant-scoped.
/// Bibliographic metadata is public fact; duplicating it per project would
/// mean re-fetching every provider for every project, which is both slower
/// and ruder to APIs that are free.
model Work {
  id String @id @default(uuid()) @db.Uuid

  // Identifiers, in descending order of dedupe confidence.
  doi        String? @unique
  arxivId    String? @unique @map("arxiv_id")
  openalexId String? @unique @map("openalex_id")
  pmid       String? @unique

  /// Lowercased, punctuation-stripped, whitespace-collapsed. The last-resort
  /// dedupe key when no identifier matches.
  titleNorm String  @map("title_norm")
  title     String
  abstract  String?

  /// [{ name, orcid, affiliation, position }]
  authors       Json
  venue         String?
  publishedYear Int?      @map("published_year")
  publishedOn   DateTime? @map("published_on") @db.Timestamptz(3)
  type          String?

  /// R-14: from provider metadata. Drives the FTS config; never assume English.
  language String?

  oaStatus        String?  @map("oa_status")
  /// Set ONLY when Unpaywall verifies the file is legitimately redistributable.
  oaPdfUrl        String?  @map("oa_pdf_url")
  citedByCount    Int      @default(0) @map("cited_by_count")
  /// OpenAlex ids — the citation graph, used for snowballing.
  referencedWorks String[] @map("referenced_works")
  concepts        Json?

  /// author_year_shorttitle. Stable and globally unique forever: changing one
  /// breaks every \cite{} in every LaTeX project that used it.
  citationKey String? @unique @map("citation_key")

  /// R-15: a preprint and its published version are two rows joined by this
  /// edge, taken from OpenAlex and never inferred. One library entry, one
  /// PRISMA count.
  versionOfId String? @map("version_of_id") @db.Uuid

  fetchedAt DateTime? @map("fetched_at") @db.Timestamptz(3)
  /// Cached provider payloads. Hit each API once, ever.
  raw       Json?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Generated column, defined in hand-written SQL as
  /// `build_tsvector(language, title/abstract)` — R-14.
  ///
  /// Declared here so `db:diff` sees no drift. Both halves matter: Unsupported
  /// keeps Prisma from emitting a DROP COLUMN and keeps it out of the
  /// generated client so nothing can write to it, and dbgenerated() keeps it
  /// from emitting `ALTER COLUMN … DROP DEFAULT`, which reads harmlessly and
  /// would delete the generation expression.
  searchTsv Unsupported("tsvector")? @default(dbgenerated()) @map("search_tsv")

  versionOf    Work?         @relation("WorkVersions", fields: [versionOfId], references: [id])
  versions     Work[]        @relation("WorkVersions")
  projectWorks ProjectWork[]
  files        FileObject[]

  @@index([titleNorm, publishedYear])
  @@index([versionOfId])
  /// Declared here, created in SQL. Without these two, `db:diff` proposes
  /// dropping them on every run.
  @@index([searchTsv(ops: raw("tsvector_ops"))], type: Gin, map: "works_search_idx")
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "works_title_trgm_idx")
  @@map("works")
}

/// A stored federated query. Re-run on a schedule and diffed against what the
/// project has already seen (R-22: pg_cron, since Vercel has no cron triggers).
model SavedSearch {
  id          String        @id @default(uuid()) @db.Uuid
  projectId   String        @map("project_id") @db.Uuid
  name        String
  /// { terms, providers, filters, dateRange }
  query       Json
  cadence     DigestCadence @default(WEEKLY)
  lastRunAt   DateTime?     @map("last_run_at") @db.Timestamptz(3)
  /// Suppresses repeats across runs.
  seenWorkIds String[]      @map("seen_work_ids") @db.Uuid
  createdBy   String        @map("created_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator User    @relation("SearchCreatedBy", fields: [createdBy], references: [id])

  @@index([projectId])
  @@map("saved_searches")
}

// ═══════════════════════ Files ═══════════════════════

/// A pointer to bytes in Supabase Storage, plus everything about the file the
/// app needs without fetching it.
///
/// It is NOT the authorization record — that was the R2 design, where a Worker
/// had to check membership because object storage had no RLS. `storage.objects`
/// is a Postgres table, so the object's own policies decide who may read it,
/// keyed on the project id in its path: {projectId}/{fileId}.pdf. File access
/// is therefore the same kind of rule as every other rule here, and fails the
/// same way when someone breaks it.
model FileObject {
  id        String  @id @default(uuid()) @db.Uuid
  ownerId   String  @map("owner_id") @db.Uuid
  projectId String? @map("project_id") @db.Uuid
  workId    String? @map("work_id") @db.Uuid

  bucket      String
  /// Key within the bucket: {projectId}/{fileId}.pdf — the leading segment is
  /// what the storage policy reads, so it is load-bearing rather than tidy.
  storagePath String  @map("storage_path")
  etag        String?

  /// R-04. Defaults to a private per-user copy; only an Unpaywall-verified
  /// open-access file may be promoted to SHARED.
  residency   Residency @default(PRIVATE)
  /// SHA-256, and the dedupe key — but for SHARED rows only.
  contentHash String?   @map("content_hash")
  oaVerified  Boolean   @default(false) @map("oa_verified")

  uploadState UploadState @default(PENDING) @map("upload_state")
  mimeType    String      @map("mime_type")
  sizeBytes   Int         @map("size_bytes")
  sha256      String
  pageCount   Int?        @map("page_count")
  textStatus  TextStatus  @default(PENDING) @map("text_status")
  scanStatus  ScanStatus  @default(PENDING) @map("scan_status")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  work    Work?    @relation(fields: [workId], references: [id])
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User     @relation("FileOwner", fields: [ownerId], references: [id])
  anchors Anchor[]

  @@index([ownerId])
  @@index([projectId])
  @@index([contentHash])
  @@map("file_objects")
}

// ═══════════════════════ Corpus pipeline ═══════════════════════

/// One paper's life inside one project. The join between the global `Work`
/// and everything a team does with it.
model ProjectWork {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  workId    String @map("work_id") @db.Uuid
  addedBy   String @map("added_by") @db.Uuid
  /// search | doi | bibtex | ris | zotero | upload | snowball
  source    String

  screenStatus   ScreenStatus @default(IDENTIFIED) @map("screen_status")
  /// Controlled vocabulary, not free text: PRISMA requires exclusions reported
  /// by category, and the Phase 2 flow diagram is derived from these.
  excludeReason  String?      @map("exclude_reason")
  readStatus     ReadStatus   @default(NOT_STARTED) @map("read_status")
  priority       Int          @default(0)
  /// Computed from citations, recency, and Question.keywords overlap.
  relevanceScore Float?       @map("relevance_score")

  assigneeId String?   @map("assignee_id") @db.Uuid
  dueAt      DateTime? @map("due_at") @db.Timestamptz(3)
  readingPct Int       @default(0) @map("reading_pct")
  tags       String[]
  note       String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  work        Work                  @relation(fields: [workId], references: [id])
  adder       User                  @relation("WorkAddedBy", fields: [addedBy], references: [id])
  assignee    User?                 @relation("WorkAssignee", fields: [assigneeId], references: [id])
  questions   ProjectWorkQuestion[]
  annotations Annotation[]
  decisions   ScreeningDecision[]
  extractions Extraction[]

  @@unique([projectId, workId])
  @@index([projectId, screenStatus])
  @@index([assigneeId])
  @@map("project_works")
}

/// Which research questions a paper speaks to, and whether it supports or
/// contradicts them.
model ProjectWorkQuestion {
  projectWorkId String @map("project_work_id") @db.Uuid
  questionId    String @map("question_id") @db.Uuid
  /// -1 contradicts · 0 unset · 1..3 supports
  relevance     Int    @default(0)

  projectWork ProjectWork @relation(fields: [projectWorkId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([projectWorkId, questionId])
  @@index([questionId])
  @@map("project_work_questions")
}

/// Append-only log of screening transitions.
///
/// A screening decision that cannot be attributed is one a reviewer cannot
/// defend — "the four of us agreed" is not a record. Also the raw material
/// for Phase 2b's inter-rater agreement.
///
/// There is deliberately no UPDATE or DELETE policy on this table.
model ScreeningDecision {
  id            String        @id @default(uuid()) @db.Uuid
  projectId     String        @map("project_id") @db.Uuid
  projectWorkId String        @map("project_work_id") @db.Uuid
  decidedBy     String        @map("decided_by") @db.Uuid
  fromStatus    ScreenStatus? @map("from_status")
  toStatus      ScreenStatus  @map("to_status")
  excludeReason String?       @map("exclude_reason")
  note          String?
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectWork ProjectWork @relation(fields: [projectWorkId], references: [id], onDelete: Cascade)
  decider     User        @relation(fields: [decidedBy], references: [id])

  @@index([projectId, createdAt(sort: Desc)], map: "screening_decisions_project_idx")
  @@index([projectWorkId, createdAt(sort: Desc)], map: "screening_decisions_work_idx")
  @@map("screening_decisions")
}

// ═══════════════════════ Extraction protocol ═══════════════════════

/// The questions asked of every paper in a project.
///
/// Versioned rather than edited in place: an evidence table is only coherent
/// if every row answered the same questions, so changing a protocol after
/// extractions exist creates a new version instead of silently altering what
/// past extractors were asked.
model Protocol {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  name        String
  version     Int      @default(1)
  isActive    Boolean  @default(true) @map("is_active")
  /// R-06 / Phase 2b: two independent extractions before a value is trusted.
  dualExtract Boolean  @default(false) @map("dual_extract")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fields      ProtocolField[]
  extractions Extraction[]

  @@unique([projectId, name, version])
  @@index([projectId, isActive])
  @@map("protocols")
}

model ProtocolField {
  id             String    @id @default(uuid()) @db.Uuid
  protocolId     String    @map("protocol_id") @db.Uuid
  /// Stable machine key. IMMUTABLE once any ExtractionValue references it —
  /// renaming would silently reassign every recorded answer to a different
  /// question. Changing a field means a new protocol version.
  key            String
  label          String
  type           FieldType
  /// ENUM/MULTI_ENUM choices.
  options        Json?
  required       Boolean   @default(false)
  /// Forces provenance: the value cannot be saved without an Anchor.
  requiresAnchor Boolean   @default(false) @map("requires_anchor")
  helpText       String?   @map("help_text")
  order          Int
  /// Ties a field to the research question it answers, so coverage can be
  /// reported per question rather than per field.
  questionId     String?   @map("question_id") @db.Uuid

  protocol Protocol          @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  question Question?         @relation(fields: [questionId], references: [id])
  values   ExtractionValue[]

  @@unique([protocolId, key])
  @@index([protocolId, order])
  @@map("protocol_fields")
}

/// One extractor's answers for one paper under one protocol.
model Extraction {
  id             String           @id @default(uuid()) @db.Uuid
  projectId      String           @map("project_id") @db.Uuid
  projectWorkId  String           @map("project_work_id") @db.Uuid
  protocolId     String           @map("protocol_id") @db.Uuid
  extractorId    String           @map("extractor_id") @db.Uuid
  status         ExtractionStatus @default(DRAFT)
  origin         ExtractionOrigin @default(HUMAN)
  /// Phase 2b: the extraction ids a reconciliation drew from.
  reconciledFrom String[]         @map("reconciled_from") @db.Uuid
  verifiedBy     String?          @map("verified_by") @db.Uuid
  submittedAt    DateTime?        @map("submitted_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectWork ProjectWork       @relation(fields: [projectWorkId], references: [id], onDelete: Cascade)
  protocol    Protocol          @relation(fields: [protocolId], references: [id])
  extractor   User              @relation("ExtractionExtractor", fields: [extractorId], references: [id])
  verifier    User?             @relation("ExtractionVerifiedBy", fields: [verifiedBy], references: [id])
  values      ExtractionValue[]

  /// One extraction per person per paper per protocol. Dual extraction is two
  /// rows by two people, never one row edited twice.
  @@unique([projectWorkId, protocolId, extractorId])
  @@index([projectId, status])
  /// evidence_rows() filters on exactly this pair. Neither the index above nor
  /// the unique constraint (which leads with projectWorkId) serves it.
  @@index([projectId, protocolId], map: "extractions_project_protocol_idx")
  @@map("extractions")
}

model ExtractionValue {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  extractionId String   @map("extraction_id") @db.Uuid
  fieldId      String   @map("field_id") @db.Uuid
  /// Typed, and PLAINTEXT on purpose (ADR-001): the evidence table sorts,
  /// filters and pivots server-side, which a ciphertext column cannot do.
  value        Json
  /// Flattened for FTS and duplicate detection.
  valueText    String?  @map("value_text")
  /// Required when the field sets requiresAnchor — enforced by trigger.
  anchorId     String?  @map("anchor_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  extraction Extraction    @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  field      ProtocolField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  /// NoAction, explicitly. Prisma's default for an optional relation is
  /// SetNull, which nobody chose and which contradicts the trigger above: the
  /// cascade nulls anchor_id, the trigger refuses the update, and the delete
  /// fails naming a field the user never touched. NoAction rather than
  /// Restrict so a whole project still deletes in one statement.
  /// See 20260815090000_anchor_delete_no_action.sql.
  anchor     Anchor?       @relation(fields: [anchorId], references: [id], onDelete: NoAction)

  @@unique([extractionId, fieldId])
  @@index([projectId])
  @@map("extraction_values")
}

// ═══════════════════════ Reading ═══════════════════════

/// A precise location in a source document.
/// Resolution order: character offsets → exact quote → fuzzy quote match.
///
/// Every Phase 2 extraction resolves through this table, which makes it the
/// highest-consequence thing in Phase 1.
model Anchor {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  fileId    String? @map("file_id") @db.Uuid

  page     Int?
  /// Plaintext, so cited passages are searchable.
  quote    String
  prefix   String?
  suffix   String?
  startOff Int?    @map("start_off")
  endOff   Int?    @map("end_off")
  /// Highlight geometry for the PDF layer.
  rects    Json?
  section  String?

  status AnchorStatus @default(OK)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  file             FileObject?       @relation(fields: [fileId], references: [id], onDelete: Cascade)
  annotations      Annotation[]
  extractionValues ExtractionValue[]

  @@index([projectId])
  @@index([fileId, page])
  @@index([quote(ops: raw("gin_trgm_ops"))], type: Gin, map: "anchors_quote_trgm_idx")
  @@map("anchors")
}

model Annotation {
  id            String @id @default(uuid()) @db.Uuid
  projectId     String @map("project_id") @db.Uuid
  projectWorkId String @map("project_work_id") @db.Uuid
  anchorId      String @map("anchor_id") @db.Uuid
  authorId      String @map("author_id") @db.Uuid

  kind       AnnotationKind       @default(HIGHLIGHT)
  color      String?
  /// Plaintext — searchable. Annotations are server-confidential, not E2EE
  /// (ADR-001): the whole point is that a supervisor can read them.
  body       String?
  visibility AnnotationVisibility @default(PROJECT)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  projectWork ProjectWork @relation(fields: [projectWorkId], references: [id], onDelete: Cascade)
  anchor      Anchor      @relation(fields: [anchorId], references: [id], onDelete: Cascade)
  author      User        @relation("AnnotationAuthor", fields: [authorId], references: [id])

  @@index([projectWorkId])
  @@index([projectId, authorId])
  @@index([anchorId])
  @@map("annotations")
}
