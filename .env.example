# ── Database ────────────────────────────────────────────────────────────────
# Runtime: Supavisor transaction pooler (port 6543). Prisma client uses this.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# Migrations: direct connection (port 5432). `migrate deploy` issues
# SET session_replication_role and CANNOT run through the transaction pooler.
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH"

# SERVER ONLY. Bypasses RLS entirely. Must never appear in a client-reachable
# module — ESLint and a CI grep both fail the build if it does.
SUPABASE_SECRET_KEY="sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz"

# ── Collaboration relay (ADR-020) ───────────────────────────────────────────
# Generate with: node apps/relay/scripts/generate-keys.mjs
# Vercel signs tickets with the private key; the relay only verifies with the
# public one, so a relay compromise cannot mint access.
NEXT_PUBLIC_RELAY_URL="ws://127.0.0.1:8787"
RELAY_PRIVATE_KEY=""

# ── Scheduled account deletion ──────────────────────────────────────────────
# A shared secret for /tasks/purge-accounts, which carries out the deletions
# whose 30-day grace period has run out. There is no background worker in this
# app, so SOMETHING has to call it — a Vercel Cron on the hosted service, or
# your own cron, or you by hand. Until it is called, an account that asked to be
# deleted waits.
#
# The cron itself is declared in apps/web/vercel.json — NOT at the repo root,
# because this project's Vercel Root Directory is apps/web and that is where
# vercel.json is read from.
#
# The NAME is not a choice. Vercel attaches `Authorization: Bearer <value>` to a
# cron invocation automatically, and only for a variable spelled exactly
# CRON_SECRET; `vercel.json` cannot set a header of its own. Any other name and
# every scheduled run 401s forever, quietly, because Vercel does not retry.
#
# Generate one yourself — at least 16 characters, and it never needs to be
# derived from anything:
#
#   openssl rand -base64 32
#
# Leave it empty and the endpoint refuses every request: an unconfigured secret
# must fail closed, and empty is what a fresh install starts with.
#
#   curl https://your-instance/tasks/purge-accounts \
#        -H "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=""

# ── Google Workspace Integration ────────────────────────────────────────────
# Used by Supabase Auth and Google APIs (Docs, Drive, Sheets)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=""
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=""
